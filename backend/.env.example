# Copy the lines you are missing into backend/.env (never commit .env)

APP_NAME=Marco
DATABASE_URL=postgresql+psycopg://...        # already in your .env
SUPABASE_URL=https://xxxx.supabase.co        # already in your .env
SUPABASE_ANON_KEY=sb_publishable_...                   # NEW: Supabase -> Settings -> API -> anon public

PUBLIC_URL=http://localhost:8000

# Speech to text: buzzasr (local Whisper, works now) or chimege (needs token)
STT_PROVIDER=buzzasr
CHIMEGE_TOKEN=                               # console.chimege.com

# Voice: mn-MN-BataaNeural (male) or mn-MN-YesuiNeural (female)
TTS_VOICE=mn-MN-BataaNeural

# AI brain (Ollama must be running: ollama serve)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:26b

# Google OAuth client JSON (Web application), saved in the backend folder
GOOGLE_CLIENT_FILE=credentials.json
